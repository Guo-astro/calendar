{
    "name": "calendar-tool",
    "version": "1.0.3",
    "description": "Chinese lunar calendar",
    "author": "HaoLe Zheng",
    "license": "MIT",
    "keywords": [
        "万年历",
        "阴阳历",
        "农历"
    ],
    "main": "./dist/calendar.min.js",
    "module": "./dist/calendar.min.mjs",
    "exports": {
        ".": {
            "default": "./dist/calendar.min.js",
            "import": "./dist/calendar.min.mjs"
        },
        "./widget-calendar": {
            "default": "./dist/widget-calendar.min.js",
            "import": "./dist/widget-calendar.min.mjs"
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mumuy/calendar.git"
    },
    "bugs": {
        "url": "https://github.com/mumuy/calendar/issues"
    },
    "engines": {
        "node": ">=20",
        "yarn": "please-use-npm",
        "npm": ">=8"
    },
    "files": [
        "dist"
    ],
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@babel/plugin-syntax-import-attributes": "^7.29.7",
        "@babel/plugin-transform-class-properties": "^8.0.1",
        "@babel/plugin-transform-runtime": "^8.0.1",
        "@babel/preset-env": "^8.0.2",
        "@babel/runtime": "^8.0.0",
        "@rollup/plugin-babel": "^7.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "rollup": "^4.63.1",
        "rollup-plugin-import-css": "^4.2.1"
    },
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -wc"
    },
    "homepage": "https://passer-by.com/calendar/",
    "directories": {}
}
